{
  "manifest_version": 3,
  "name": "CUS Assist",
  "version": "1.8.1",
  "description": "Helps your recruiting team fill in job applications. You do the clicking and submitting; CUS Assist fills in the forms.",
  "permissions": [
    "storage",
    "tabs",
    "alarms"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle",
      "all_frames": true
    },
    {
      "matches": [
        "https://*.glassdoor.com/*",
        "https://*.glassdoor.co.in/*",
        "https://*.glassdoor.co.uk/*",
        "https://*.glassdoor.ca/*",
        "https://*.glassdoor.com.au/*"
      ],
      "js": [
        "main-world.js"
      ],
      "run_at": "document_start",
      "world": "MAIN"
    }
  ],
  "action": {
    "default_title": "CUS Assist",
    "default_popup": "popup.html"
  }
}
